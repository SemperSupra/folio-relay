{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sempersupra.github.io/folio-relay/contracts/printer-identity.schema.json",
  "title": "FolioRelay Canonical Printer Identity",
  "type": "object",
  "additionalProperties": false,
  "required": ["display_name", "printer_uuid", "scheme", "host", "port", "resource_path"],
  "properties": {
    "display_name": {"type": "string", "minLength": 1, "maxLength": 127},
    "location": {"type": "string", "maxLength": 255, "default": ""},
    "printer_uuid": {
      "type": "string",
      "pattern": "^urn:uuid:[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$"
    },
    "scheme": {"enum": ["ipp", "ipps"]},
    "host": {"type": "string", "minLength": 1, "maxLength": 253},
    "port": {"type": "integer", "minimum": 1, "maximum": 65535},
    "resource_path": {
      "type": "string",
      "pattern": "^/[^?#]*$",
      "minLength": 2,
      "maxLength": 1024
    }
  }
}
