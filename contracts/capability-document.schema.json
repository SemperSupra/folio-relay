{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://sempersupra.github.io/folio-relay/contracts/capability-document.schema.json",
  "title": "FolioRelay Capability Document",
  "type": "object",
  "additionalProperties": false,
  "required": ["product", "api_version", "status", "printer", "profiles", "links"],
  "properties": {
    "product": {"const": "FolioRelay"},
    "api_version": {"type": "string", "pattern": "^v[0-9]+$"},
    "status": {"enum": ["ready", "degraded", "action-required"]},
    "printer": {"$ref": "printer-identity.schema.json"},
    "profiles": {
      "type": "object",
      "additionalProperties": false,
      "required": ["windows_ipp", "airprint"],
      "properties": {
        "windows_ipp": {"type": "boolean"},
        "airprint": {"type": "boolean"}
      }
    },
    "links": {
      "type": "object",
      "additionalProperties": false,
      "required": ["openapi", "status", "jobs", "self_test"],
      "properties": {
        "openapi": {"type": "string"},
        "status": {"type": "string"},
        "jobs": {"type": "string"},
        "self_test": {"type": "string"}
      }
    }
  }
}
